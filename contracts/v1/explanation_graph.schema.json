{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.upgradeguard.invalid/v1/explanation_graph.schema.json",
  "title": "Explanation graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "nodes", "edges", "findings", "limitations"],
  "properties": {
    "summary": {"type": "string", "maxLength": 800},
    "nodes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "change", "evidence_ids", "inferred"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 60},
          "kind": {"enum": ["component", "package", "config", "test"]},
          "change": {"enum": ["added", "modified", "removed", "unchanged"]},
          "failed": {"type": "boolean"},
          "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z]+:[A-Za-z0-9_./:-]{1,120}$"}},
          "inferred": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "relation", "evidence_ids", "inferred"],
        "properties": {
          "source": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "target": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "relation": {"enum": ["depends_on", "imports", "configures", "tests"]},
          "evidence_ids": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z]+:[A-Za-z0-9_./:-]{1,120}$"}},
          "inferred": {"type": "boolean"}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids"],
        "properties": {
          "text": {"type": "string", "maxLength": 300},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z]+:[A-Za-z0-9_./:-]{1,120}$"}}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 300}}
  }
}
