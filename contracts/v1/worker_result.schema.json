{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.upgradeguard.invalid/v1/worker_result.schema.json",
  "title": "Worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "operation", "job_state", "verdict", "evidence_path", "error", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "operation": {"type": ["string", "null"], "enum": ["SNAPSHOT", "COMPARE", "REHEARSE_UPGRADE", "REHEARSE_RECOVERY", null]},
    "job_state": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "INTERRUPTED"]},
    "verdict": {"enum": ["ACCEPT", "REJECT", "INSUFFICIENT_EVIDENCE", null]},
    "evidence_path": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
      "not": {"type": "string", "pattern": "(^|/)\\.\\.(/|$)"}
    },
    "error": {"type": ["string", "null"], "maxLength": 1000},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"job_state": {"const": "SUCCEEDED"}}}, "then": {"properties": {"evidence_path": {"type": "string"}}}},
    {"if": {"properties": {"job_state": {"enum": ["FAILED", "TIMED_OUT", "CANCELLED", "INTERRUPTED"]}}}, "then": {"properties": {"verdict": {"const": null}}}}
  ]
}
