{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.upgradeguard.invalid/v1/prediction_response.schema.json",
  "title": "Prediction response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "model_version", "feature_schema_version", "risk_score", "supported_scope", "explanations", "timing_ms"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["OK", "MODEL_UNAVAILABLE", "UNSUPPORTED_ECOSYSTEM", "INVALID_FEATURES"]},
    "model_version": {"type": ["string", "null"], "maxLength": 64},
    "feature_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "risk_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "supported_scope": {"type": "string", "maxLength": 200},
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "value"],
        "properties": {
          "feature": {"type": "string", "maxLength": 64},
          "value": {"type": ["number", "string", "boolean", "null"]},
          "contribution": {"type": "number"}
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference"],
      "properties": {
        "inference": {"type": "number", "minimum": 0},
        "feature_acquisition": {"type": "number", "minimum": 0}
      }
    }
  },
  "if": {"properties": {"status": {"const": "OK"}}},
  "then": {
    "properties": {"risk_score": {"type": "number"}, "model_version": {"type": "string"}}
  },
  "else": {
    "properties": {"risk_score": {"type": "null"}}
  }
}
