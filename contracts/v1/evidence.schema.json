{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "request", "diff", "verdict", "coverage", "artifact_manifest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "request.schema.json#/$defs/id"},
    "request": {"$ref": "request.schema.json"},
    "before": {"$ref": "#/$defs/side"},
    "after": {"$ref": "#/$defs/side"},
    "diff": {"$ref": "#/$defs/diff"},
    "verdict": {"$ref": "#/$defs/verdict"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "prediction": {"$ref": "prediction_response.schema.json"},
    "explanation": {"$ref": "#/$defs/explanation"},
    "artifact_manifest": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "if": {
    "properties": {
      "request": {"properties": {"operation": {"enum": ["REHEARSE_UPGRADE", "REHEARSE_RECOVERY"]}}}
    }
  },
  "then": {"required": ["before", "after"]},
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "exit_code", "duration_seconds"],
      "properties": {
        "outcome": {"enum": ["PASS", "FAIL", "UNAVAILABLE", "NOT_RUN", "TIMED_OUT"]},
        "exit_code": {"type": ["integer", "null"]},
        "duration_seconds": {"type": "number", "minimum": 0},
        "log_artifact": {"type": "string"}
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "build", "tests", "resolved_dependencies", "scanner_results", "environment"],
      "properties": {
        "install": {"$ref": "#/$defs/stage"},
        "build": {"$ref": "#/$defs/stage"},
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "results"],
          "properties": {
            "stage": {"$ref": "#/$defs/stage"},
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "outcome"],
                "properties": {
                  "id": {"type": "string", "maxLength": 500},
                  "outcome": {"enum": ["PASS", "FAIL", "ERROR", "SKIP", "MISSING"]}
                }
              }
            }
          }
        },
        "resolved_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "maxLength": 200},
              "version": {"$ref": "request.schema.json#/$defs/version"}
            }
          }
        },
        "scanner_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scanner", "version", "available", "coverage", "checked_at"],
            "properties": {
              "scanner": {"type": "string", "maxLength": 64},
              "version": {"type": "string", "maxLength": 64},
              "available": {"type": "boolean"},
              "coverage": {"type": "string", "maxLength": 200},
              "checked_at": {"type": "string", "format": "date-time"},
              "finding_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "environment": {"$ref": "request.schema.json#/$defs/environment"}
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "tests"],
      "properties": {
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "changed"],
          "properties": {
            "added": {"type": "array", "items": {"type": "string"}},
            "removed": {"type": "array", "items": {"type": "string"}},
            "changed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "from", "to"],
                "properties": {
                  "name": {"type": "string"},
                  "from": {"type": "string"},
                  "to": {"type": "string"}
                }
              }
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regressions", "new_failing", "missing_or_skipped"],
          "properties": {
            "regressions": {"type": "array", "items": {"type": "string"}},
            "new_failing": {"type": "array", "items": {"type": "string"}},
            "missing_or_skipped": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "subject", "message", "evidence_ids", "provenance"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "severity": {"enum": ["INFO", "WARNING", "BLOCKING"]},
        "subject": {"type": "string", "maxLength": 500},
        "message": {"type": "string", "maxLength": 1000},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "string", "maxLength": 200}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "findings"],
      "properties": {
        "decision": {"enum": ["ACCEPT", "REJECT", "INSUFFICIENT_EVIDENCE"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "not_checked", "unavailable"],
      "properties": {
        "checked": {"type": "array", "items": {"type": "string"}},
        "not_checked": {"type": "array", "items": {"type": "string"}},
        "unavailable": {"type": "array", "items": {"type": "string"}}
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "text", "source_ids"],
      "properties": {
        "provider": {"type": "string", "maxLength": 64},
        "model": {"type": "string", "maxLength": 100},
        "text": {"type": "string", "maxLength": 5000},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "media_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "sha256": {"$ref": "request.schema.json#/$defs/sha256"},
        "media_type": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$"}
      }
    }
  }
}
